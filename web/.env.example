# Environment
APP_ENV=local

# Supabase Postgres (Mumbai ap-south-1)
# Note: Always use the Supavisor transaction pooler (port 6543) with prepare: false
DATABASE_URL=postgres://postgres.<project_ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase Auth & Public API
NEXT_PUBLIC_SUPABASE_URL=https://<project_ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# AES-256-GCM encryption key for voucher codes at rest (32 bytes base64-encoded)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
VOUCHER_ENCRYPTION_KEY=

# AES-256-GCM encryption key for automated portal credentials at rest (32 bytes base64-encoded)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
PORTAL_CREDENTIAL_ENCRYPTION_KEY=
