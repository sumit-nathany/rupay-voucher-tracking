# Configuration for the ordering worker's Google Cloud deployment.
#
# Copy this file to `config.env` and edit it. `config.env` is gitignored —
# never commit a filled-in copy with real project identifiers if they are
# sensitive (they are not, but keeping one source of truth is easier).
#
# No secret VALUES belong here. Secrets live in Google Secret Manager and are
# referenced by name below. See ../../docs/worker-hosting-runbook.md.

# ── Project ──────────────────────────────────────────────────────────────────
# One project per environment. Never point prod and preprod at the same one.
GCP_PROJECT_ID=rupay-order-worker-prod
GCP_REGION=asia-south1
GCP_BILLING_ACCOUNT_ID=REPLACE_ME

# ── Resources ────────────────────────────────────────────────────────────────
REPOSITORY=worker
JOB_NAME=rupay-order-worker
SCHEDULER_JOB_NAME=rupay-order-worker-hourly

# ── Service accounts ─────────────────────────────────────────────────────────
# RUN_SA executes the job: it may read the secrets below and write logs.
# SCHEDULER_SA only invokes the job. It must NOT be able to read secrets.
RUN_SA=rupay-order-worker-run
SCHEDULER_SA=rupay-order-worker-scheduler

# ── Job shape ────────────────────────────────────────────────────────────────
# One task, one at a time. Both are hard guards against two concurrent runs
# racing for the same portal account. (A Cloud Run *Job* expresses this as
# --tasks/--parallelism, not the service's --max-instances.)
MAX_INSTANCES=1
TASK_TIMEOUT=1800
CPU=1
MEMORY=2Gi

# ── Schedule ─────────────────────────────────────────────────────────────────
# Cloud Scheduler cron syntax. Hourly is the finest cadence that cannot
# over-order: the portal allows one order per portal account per 24 hours and
# eligibility is enforced in the database.
SCHEDULE="every 1 hours"
SCHEDULE_TIMEZONE=Asia/Kolkata

# ── Secret Manager secret names ──────────────────────────────────────────────
SECRET_WORKER_DATABASE_URL=WORKER_DATABASE_URL
SECRET_PORTAL_KEY=PORTAL_CREDENTIAL_ENCRYPTION_KEY
SECRET_CAPTCHA_SOLVER=CAPSOLVER_API_KEY

# CapMonster — the cheapest token service at $0.60 per 1,000 solves, with the
# proxy included in the price. It also gives a $0.10 test balance on request:
# ask their support.
SECRET_CAPTCHA_MONSTER=CAPMONSTER_API_KEY

# YesCaptcha — 1,500 free points on signup (about 100 v2 tokens), claimed by
# asking their support. 1,000 points is ¥1, so a token is ¥0.015.
SECRET_CAPTCHA_YESCAPTCHA=YESCAPTCHA_API_KEY
SECRET_GEMINI=GEMINI_API_KEY

# The shared solving service. Its key is presented as `X-Solver-Key`.
#
# Leave CAPTCHA_SERVICE_URL empty to keep using the worker's own local
# captcha solver. Set it to the service's URL to switch the worker over to
# the service instead. The local solver is untouched either way.
SECRET_CAPTCHA_SERVICE_KEY=RECAPTCHA_SOLVER_KEY

# The deployed service. Set this to switch the worker over to it; leave it
# empty to keep using the worker's own local solver.
CAPTCHA_SERVICE_URL=https://recaptcha-solver-460127296389.asia-south1.run.app

# Optional. Only needed if a stored portal credential was encrypted with a
# rotated key that is no longer the primary one. The keyring is a
# space-separated list of base64 keys, tried in order.
SECRET_ENCRYPTION_KEYRING=ENCRYPTION_KEYRING

# ── Budget ───────────────────────────────────────────────────────────────────
BUDGET_DISPLAY_NAME=rupay-order-worker-budget
BUDGET_AMOUNT_USD=5
BUDGET_ALERT_THRESHOLDS=0.5,0.9,1.0
