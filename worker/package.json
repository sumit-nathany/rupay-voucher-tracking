{
  "name": "rupay-ordering-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/worker.js",
    "dev": "tsx src/batch.ts",
    "dev:preprod": "tsx --env-file ../web/.env.preprod src/batch.ts",
    "batch:local": "tsx --env-file ../web/.env.local src/batch.ts",
    "batch:preprod": "tsx --env-file ../web/.env.preprod src/batch.ts",
    "batch:prod": "tsx --env-file ../web/.env.prod src/batch.ts",
    "daemon:preprod": "tsx --env-file ../web/.env.preprod src/daemon.ts",
    "daemon:local": "tsx --env-file ../web/.env.local src/daemon.ts",
    "login:preprod": "tsx --env-file ../web/.env.preprod src/login-helper.ts",
    "browser:prod": "RUN_BROWSER_RUNNER_CLI=true tsx --env-file ../web/.env.prod src/browser-runner.ts",
    "browser:preprod": "RUN_BROWSER_RUNNER_CLI=true tsx --env-file ../web/.env.preprod src/browser-runner.ts",
    "browser:local": "RUN_BROWSER_RUNNER_CLI=true tsx --env-file ../web/.env.local src/browser-runner.ts",
    "test:live": "RUN_BROWSER_RUNNER_CLI=true tsx --env-file ../web/.env.local src/browser-runner.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "playwright": "^1.64.0",
    "playwright-extra": "^4.3.6",
    "postgres": "^3.4.9",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vitest": "^5.0.5"
  }
}
