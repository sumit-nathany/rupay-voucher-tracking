{
  "name": "rupay-ordering-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:preprod": "tsx --env-file ../web/.env.preprod src/index.ts",
    "daemon:preprod": "tsx --env-file ../web/.env.preprod src/daemon.ts",
    "login:preprod": "tsx --env-file ../web/.env.preprod src/login-helper.ts",
    "browser:preprod": "tsx --env-file ../web/.env.preprod src/browser-runner.ts",
    "browser:local": "tsx --env-file ../web/.env.local src/browser-runner.ts",
    "test:live": "tsx --env-file ../web/.env.local src/browser-runner.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "playwright": "^1.64.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  }
}
